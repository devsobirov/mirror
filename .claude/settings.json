{
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(git push origin *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git push origin master*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:master*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f*)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)"
    ]
  }
}
